<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="64dp"
    android:paddingTop="27dp"
    android:paddingEnd="64dp"
    android:paddingBottom="27dp">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:textColor="@color/accent"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/sub"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/audioInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/audio_info_bg"
            android:fontFamily="@font/dmsans_medium"
            android:letterSpacing="0.04"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:singleLine="true"
            android:textColor="#BBFFFFFF"
            android:textSize="10sp"
            android:visibility="invisible" />

        <LinearLayout
            android:id="@+id/seekArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="-8dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="-8dp"
            android:background="@drawable/seek_bg"
            android:focusable="true"
            android:orientation="vertical"
            android:padding="8dp">

            <cl.plexmusica.tv.WaveformView
                android:id="@+id/waveform"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:visibility="invisible" />

            <ProgressBar
                android:id="@+id/progress"
                android:visibility="gone"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_marginTop="8dp"
                android:max="1000"
                android:progressBackgroundTint="#55FFFFFF"
                android:progressTint="@color/accent" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sub"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/seekHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="@string/seek_hint"
                android:textColor="@color/sub"
                android:textSize="14sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sub"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton android:id="@+id/btnPrev" style="@style/RoundButton" android:contentDescription="@string/cd_prev" android:src="@drawable/ic_prev" />
            <ImageButton android:id="@+id/btnPlay" style="@style/RoundButton" android:layout_width="60dp" android:layout_height="60dp" android:padding="14dp" android:contentDescription="@string/cd_play" android:src="@drawable/ic_play" />
            <ImageButton android:id="@+id/btnNext" style="@style/RoundButton" android:contentDescription="@string/cd_next" android:src="@drawable/ic_next" />
            <ImageButton android:id="@+id/btnShuffleMode" style="@style/RoundButton" android:contentDescription="@string/cd_shuffle" android:src="@drawable/ic_shuffle" />
            <ImageButton android:id="@+id/btnQueue" style="@style/RoundButton" android:contentDescription="@string/cd_queue" android:src="@drawable/ic_queue" />
            <ImageButton android:id="@+id/btnVisualizer" style="@style/RoundButton" android:contentDescription="@string/cd_visualizer" android:src="@drawable/ic_visualizer" />
        </LinearLayout>

        <TextView
            android:id="@+id/nextUp"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/sub"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
