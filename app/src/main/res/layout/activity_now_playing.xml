<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="64dp"
    android:paddingTop="27dp"
    android:paddingEnd="64dp"
    android:paddingBottom="27dp">

    <ImageView
        android:id="@+id/cover"
        android:layout_width="380dp"
        android:layout_height="380dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="48dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:singleLine="true"
            android:textColor="@color/accent"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/album"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:textColor="@color/sub"
            android:textSize="18sp" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="32dp"
            android:max="1000"
            android:progressBackgroundTint="#55FFFFFF"
            android:progressTint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/position"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/sub"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/sub"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton android:id="@+id/btnPrev" style="@style/RoundButton" android:contentDescription="@string/cd_prev" android:src="@drawable/ic_prev" />
            <ImageButton android:id="@+id/btnPlay" style="@style/RoundButton" android:layout_width="80dp" android:layout_height="80dp" android:contentDescription="@string/cd_play" android:src="@drawable/ic_play" />
            <ImageButton android:id="@+id/btnNext" style="@style/RoundButton" android:contentDescription="@string/cd_next" android:src="@drawable/ic_next" />
            <ImageButton android:id="@+id/btnShuffleMode" style="@style/RoundButton" android:contentDescription="@string/cd_shuffle" android:src="@drawable/ic_shuffle" />
        </LinearLayout>

        <TextView
            android:id="@+id/nextUp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:singleLine="true"
            android:ellipsize="end"
            android:textColor="@color/sub"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
