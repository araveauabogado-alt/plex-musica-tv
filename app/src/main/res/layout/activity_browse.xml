<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="48dp"
    android:paddingTop="27dp"
    android:paddingEnd="48dp">

    <cl.plexmusica.tv.NowPlayingBar
        android:id="@+id/nowBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginBottom="12dp" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button android:id="@+id/btnPlayAll" style="@style/TvButton" android:text="@string/play_all" />
        <ImageButton android:id="@+id/btnShuffle" style="@style/RoundButton" android:layout_width="42dp" android:layout_height="42dp" android:padding="9dp" android:contentDescription="@string/shuffle" android:src="@drawable/ic_shuffle" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/sub"
        android:textSize="16sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="true">

        <cl.plexmusica.tv.TvRecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="12dp"
            android:paddingBottom="27dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:background="@drawable/top_fade" />
    </FrameLayout>
</LinearLayout>
