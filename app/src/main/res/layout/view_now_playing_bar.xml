<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="64dp">

    <!-- La carátula se puede seleccionar: lleva a Inicio -->
    <ImageView
        android:id="@+id/barArt"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:clickable="true"
        android:contentDescription="@string/bar_home"
        android:focusable="true"
        android:foreground="@drawable/bar_art_focus"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/barTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/dmsans_medium"
            android:singleLine="true"
            android:textColor="@color/text"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/barSub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="@color/sub"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/barPrev"
        style="@style/BarIconButton"
        android:contentDescription="@string/cd_prev"
        android:src="@drawable/ic_prev" />

    <ImageButton
        android:id="@+id/barToggle"
        style="@style/BarIconButton"
        android:contentDescription="@string/cd_play"
        android:src="@drawable/ic_pause" />

    <ImageButton
        android:id="@+id/barNext"
        style="@style/BarIconButton"
        android:layout_marginEnd="14dp"
        android:contentDescription="@string/cd_next"
        android:src="@drawable/ic_next" />
</merge>
