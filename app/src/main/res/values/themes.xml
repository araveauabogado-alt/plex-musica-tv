<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF121212</color>
    <color name="accent">#FFE5A00D</color>
    <color name="text">#FFFFFFFF</color>
    <color name="sub">#FFAAAAAA</color>

    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/bg</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/sub</item>
        <item name="android:fontFamily">@font/app_font</item>
        <item name="fontFamily">@font/app_font</item>
    </style>

    <style name="AppTheme.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <style name="TvButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/btn_bg</item>
        <item name="android:textColor">@color/btn_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/dmsans_medium</item>
        <item name="fontFamily">@font/dmsans_medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:minHeight">42dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:focusable">true</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <!-- Botones de la barra "Reproduciendo" (más bajos que los de pestaña) -->
    <style name="BarButton" parent="TvButton">
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:minHeight">34dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>

    <style name="BarIconButton" parent="RoundButton">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:padding">10dp</item>
    </style>

    <style name="RoundButton">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_marginEnd">14dp</item>
        <item name="android:background">@drawable/round_bg</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="tint">@color/btn_text</item>
    </style>
</resources>
